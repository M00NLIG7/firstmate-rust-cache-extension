#!/bin/sh
# Fail-open Cargo RUSTC_WRAPPER for Firstmate Rust Cache.
set -u

compiler=${1-}
backend=${FIRSTMATE_RUST_CACHE_BACKEND-}
lease_dir=${FIRSTMATE_RUST_CACHE_LEASE_DIR-}
lease_token=${FIRSTMATE_RUST_CACHE_LEASE_TOKEN-}

if [ -z "$compiler" ] || [ -z "$backend" ] || [ ! -x "$backend" ]; then
  exec "$@"
fi

lease_path=
case "$lease_token" in
  ????????????????????????????????)
    case "$lease_token" in
      *[!0123456789abcdef]*) exec "$@" ;;
    esac
    lease_helper=$(
      CDPATH=''
      export CDPATH
      cd -- "$(dirname -- "$0")" && pwd -P
    )/fm-rustc-lease.mjs || exec "$@"
    [ -r "$lease_helper" ] || exec "$@"
    lease_path=$(node "$lease_helper" create "$lease_dir" "$lease_token" "$$" 2>/dev/null) || exec "$@"
    [ -n "$lease_path" ] || exec "$@"
    ;;
  *) exec "$@" ;;
esac

cleanup() {
  if [ -n "$lease_path" ]; then node "$lease_helper" remove "$lease_dir" "$lease_path" >/dev/null 2>&1 || :; fi
}

backend_pid=
wait_backend() {
  wait "$backend_pid"
  status=$?
  cleanup
  trap - HUP INT TERM EXIT
  exit "$status"
}

forward_signal() {
  kill -"$1" "$backend_pid" 2>/dev/null || :
  wait_backend
}

trap cleanup EXIT
trap 'forward_signal HUP' HUP
trap 'forward_signal INT' INT
trap 'forward_signal TERM' TERM
"$backend" "$@" &
backend_pid=$!
wait_backend
